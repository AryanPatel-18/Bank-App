<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="350.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Main.Controllers.ResetPasswordController">
   <children>
      <PasswordField fx:id="newPassword" layoutX="68.0" layoutY="115.0" prefHeight="25.0" prefWidth="219.0" />
      <Label layoutX="68.0" layoutY="98.0" style="-fx-font-family: sans-serif; -fx-font-weight: bold;" text="Password">
         <font>
            <Font size="11.0" />
         </font>
      </Label>
      <PasswordField fx:id="confirmPassword" layoutX="66.0" layoutY="175.0" prefHeight="25.0" prefWidth="219.0" />
      <Label layoutX="68.0" layoutY="161.0" style="-fx-font-family: sans-serif; -fx-font-weight: bold;" text="Confirm Password">
         <font>
            <Font size="11.0" />
         </font>
      </Label>
      <Button fx:id="resetButton" layoutX="126.0" layoutY="250.0" mnemonicParsing="false" onAction="#verifyPassword" text="Reset Password" />
   </children>
</AnchorPane>
