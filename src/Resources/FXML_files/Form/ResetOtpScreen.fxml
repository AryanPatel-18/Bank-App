<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="318.0" prefWidth="380.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Main.Controllers.FormControllers.otpController">
   <children>
      <TextField fx:id="otpField" alignment="CENTER" layoutX="81.0" layoutY="114.0" prefHeight="50.0" prefWidth="218.0" promptText="Enter OTP" style="-fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 20, 0.1, 0, 6);">
         <font>
            <Font size="18.0" />
         </font></TextField>
      <Label layoutX="75.0" layoutY="6.0" prefHeight="68.0" prefWidth="231.0" style="-fx-font-family: sans-serif; -fx-wrap-text: true;" text="Enter the four digit code" textAlignment="CENTER">
         <font>
            <Font name="SansSerif Regular" size="20.0" />
         </font>
      </Label>
      <Label fx:id="invalidMessage" layoutX="90.0" layoutY="270.0" text="Please enter a valid value" textFill="RED">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Button fx:id="submitButton" layoutX="119.0" layoutY="201.0" mnemonicParsing="false" onAction="#checkOtpResetPassword" prefHeight="43.0" prefWidth="143.0" style="-fx-background-color: #fad625; -fx-background-radius: 50; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 20, 0.1, 0, 6);" text="Submit" textFill="WHITE">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
