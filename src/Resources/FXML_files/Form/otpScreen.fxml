<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="389.0" prefWidth="366.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Main.Controllers.FormControllers.otpController">
    <children>
        <Button fx:id="submitButton" layoutX="112.0" layoutY="225.0" mnemonicParsing="false" onAction="#checkValue" prefHeight="43.0" prefWidth="143.0" style="-fx-background-color: #fad625; -fx-background-radius: 50; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 20, 0.1, 0, 6);" text="Submit" textFill="WHITE">
         <font>
            <Font name="System Bold" size="18.0" />
         </font></Button>
        <TextField fx:id="otpField" layoutX="71.0" layoutY="117.0" prefHeight="33.0" prefWidth="225.0" promptText="Enter Otp" style="-fx-alignment: center; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 20, 0.1, 0, 6); -fx-background-radius: 10;">
         <font>
            <Font size="18.0" />
         </font></TextField>
        <Label fx:id="invalidMessage" layoutX="96.0" layoutY="342.0" text="Please enter a valid value" textFill="RED">
            <font>
                <Font name="System Italic" size="16.0" />
            </font>
        </Label>
      <Label layoutX="85.0" layoutY="36.0" prefHeight="33.0" prefWidth="198.0" style="-fx-font-weight: bold;" text="Enter the four digit code ">
         <font>
            <Font name="SansSerif Regular" size="16.0" />
         </font>
      </Label>
    </children>
</AnchorPane>
