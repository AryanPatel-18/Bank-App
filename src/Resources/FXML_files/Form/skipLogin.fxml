<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="400.0" prefWidth="301.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Main.Controllers.skipLoginController">
   <children>
      <Label layoutX="18.0" layoutY="71.0" style="-fx-font-weight: bold; -fx-font-family: sans-serif;" text="Do you want to contiue with this email? ">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <Label fx:id="emailLabel" layoutX="78.0" layoutY="131.0" text="Email would be pasted here" />
      <Button fx:id="yesButton" layoutX="78.0" layoutY="258.0" mnemonicParsing="false" onAction="#yesButton" text="Yes" />
      <Button fx:id="noButton" layoutX="202.0" layoutY="258.0" mnemonicParsing="false" onAction="#noButton" text="No" />
   </children>
</AnchorPane>
