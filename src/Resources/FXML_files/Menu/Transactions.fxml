<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="450" prefWidth="600" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Main.Controllers.MainControllers.TransactionController">

    <TableView fx:id="transactionTable" layoutX="10" layoutY="10" prefHeight="380" prefWidth="580">
        <columns>
            <TableColumn fx:id="amountColumn" prefWidth="100" text="Amount" />
            <TableColumn fx:id="receiverColumn" prefWidth="150" text="Receiver" />
            <TableColumn fx:id="senderColumn" prefWidth="150" text="Sender" />
            <TableColumn fx:id="timestampColumn" prefWidth="180" text="Timestamp" />
        </columns>
    </TableView>

    <Button fx:id="backButton" layoutX="51.0" layoutY="395.0" onAction="#loadMainScene" prefHeight="35.0" prefWidth="126.0" style="-fx-background-radius: 50;" text="Back" />
   <Button fx:id="backButton1" layoutX="237.0" layoutY="395.0" onAction="#convertFile" prefHeight="35.0" prefWidth="126.0" style="-fx-background-radius: 50;" text="Excel" />
   <Button fx:id="backButton11" layoutX="428.0" layoutY="395.0" onAction="#convertTopdf" prefHeight="35.0" prefWidth="126.0" style="-fx-background-radius: 50;" text="PDF" />

</AnchorPane>
