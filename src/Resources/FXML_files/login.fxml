<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="402.0" prefWidth="402.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Main.Controllers.LoginController">
    <children>
        <TextField fx:id="emailField" layoutX="76.0" layoutY="131.0" prefHeight="25.0" prefWidth="250.0" />
        <TextField fx:id="passwordField" layoutX="76.0" layoutY="189.0" prefHeight="25.0" prefWidth="250.0" />
        <Label layoutX="73.0" layoutY="102.0" style="-fx-font-weight: bold; -fx-font-family: sans-serif;" text="Email" textAlignment="CENTER">
            <font>
                <Font size="13.0" />
            </font>
        </Label>
        <Label layoutX="77.0" layoutY="165.0" style="-fx-font-weight: bold; -fx-font-family: sans-serif;" text="Password" textAlignment="CENTER">
            <font>
                <Font size="13.0" />
            </font>
        </Label>
        <Button fx:id="submitButton" layoutX="105.0" layoutY="282.0" mnemonicParsing="false" onAction="#login" prefHeight="31.0" prefWidth="193.0" text="Submit" />
        <RadioButton layoutX="77.0" layoutY="224.0" mnemonicParsing="false" text="Remember Me" />
        <Hyperlink layoutX="224.0" layoutY="221.0" text="Forgot Password?" />
    </children>
</AnchorPane>
